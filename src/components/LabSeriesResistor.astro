---
import Tex from './Tex.astro';
---
<section class="lab-panel" data-lab="series-resistor" style="border-top: 3px solid var(--copper)">
  <h3>직렬 저항 — KCL / KVL 스케치</h3>
  <p style="margin-top:0;color:var(--ink-muted);font-size:0.92rem">
    전압원 <Tex tex="V_s" />와 두 저항 <Tex tex="R_1,R_2" /> 직렬. KVL: <Tex tex="V_s = I R_1 + I R_2" />.
    같은 전류 <Tex tex="I" />가 흐른다(KCL의 직렬 함의).
  </p>
  <div class="lab-row">
    <div>
      <label for="vs"><Tex tex="V_s" /> (V)</label>
      <input id="vs" type="number" min="0" step="0.1" value="12" />
    </div>
    <div>
      <label for="r1"><Tex tex="R_1" /> (Ω)</label>
      <input id="r1" type="number" min="0.01" step="0.1" value="100" />
    </div>
    <div>
      <label for="r2"><Tex tex="R_2" /> (Ω)</label>
      <input id="r2" type="number" min="0.01" step="0.1" value="200" />
    </div>
  </div>
  <div class="readout" id="k-out" aria-live="polite">…</div>
</section>
<script is:inline>
  const vs = document.getElementById('vs');
  const r1 = document.getElementById('r1');
  const r2 = document.getElementById('r2');
  const out = document.getElementById('k-out');
  function update() {
    const V = Number(vs.value);
    const R1 = Number(r1.value);
    const R2 = Number(r2.value);
    if (!(R1 > 0 && R2 > 0)) {
      out.textContent = '저항은 양수여야 합니다.';
      return;
    }
    const Req = R1 + R2;
    const I = V / Req;
    const V1 = I * R1;
    const V2 = I * R2;
    out.innerHTML =
      `I = ${I.toFixed(4)} A<br>` +
      `V₁ = I·R₁ = ${V1.toFixed(4)} V · V₂ = I·R₂ = ${V2.toFixed(4)} V<br>` +
      `KVL 검산: V₁+V₂ = ${(V1 + V2).toFixed(4)} V ${Math.abs(V1 + V2 - V) < 1e-9 ? '= Vs ✓' : '≠ Vs'}`;
  }
  [vs, r1, r2].forEach((el) => el.addEventListener('input', update));
  update();
</script>
