---
import Tex from './Tex.astro';
---
<section class="lab-panel" data-lab="bsc-capacity" style="border-top: 3px solid var(--cyan)">
  <h3>BSC 용량 <Tex tex="C = 1 - H_b(p)" /></h3>
  <p style="margin-top:0;color:var(--ink-muted);font-size:0.92rem">
    이진 대칭 채널(BSC)의 교차 확률 <Tex tex="p" />. 용량은 <Tex tex="C = 1 - H_b(p)" /> (비트/전송).
  </p>
  <label for="bsc-p">교차 확률 <Tex tex="p" /></label>
  <input id="bsc-p" type="range" min="0" max="0.5" step="0.001" value="0.1" />
  <div class="readout" id="bsc-out" aria-live="polite">…</div>
</section>
<script is:inline>
  function Hb(p) {
    if (p <= 0 || p >= 1) return 0;
    return -p * Math.log2(p) - (1 - p) * Math.log2(1 - p);
  }
  const slider = document.getElementById('bsc-p');
  const out = document.getElementById('bsc-out');
  function update() {
    const p = Number(slider.value);
    const hb = Hb(p);
    const C = 1 - hb;
    out.textContent = `p = ${p.toFixed(3)}  →  Hb(p) = ${hb.toFixed(4)}  →  C = ${C.toFixed(4)} bit/use`;
  }
  slider.addEventListener('input', update);
  update();
</script>
