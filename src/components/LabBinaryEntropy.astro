---
import Tex from './Tex.astro';
---
<section class="lab-panel" data-lab="binary-entropy" style="border-top: 3px solid var(--cyan)">
  <h3>이진 엔트로피 <Tex tex="H(p)" /></h3>
  <p style="margin-top:0;color:var(--ink-muted);font-size:0.92rem">
    <Tex tex="H(p) = -p\log_2 p - (1-p)\log_2(1-p)" /> (비트). 슬라이더로 <Tex tex="p" />를 바꿔 보세요.
  </p>
  <label for="hp-p">베르누이 성공 확률 <Tex tex="p" /></label>
  <input id="hp-p" type="range" min="0.001" max="0.999" step="0.001" value="0.5" />
  <div class="readout" id="hp-out" aria-live="polite">…</div>
  <canvas id="hp-canvas" width="480" height="160" style="width:100%;margin-top:0.85rem;border-radius:4px;background:var(--cream-dark)"></canvas>
</section>
<script is:inline>
  function Hb(p) {
    if (p <= 0 || p >= 1) return 0;
    return -p * Math.log2(p) - (1 - p) * Math.log2(1 - p);
  }
  const slider = document.getElementById('hp-p');
  const out = document.getElementById('hp-out');
  const canvas = document.getElementById('hp-canvas');
  const ctx = canvas.getContext('2d');

  function draw(p) {
    const w = canvas.width, h = canvas.height;
    ctx.clearRect(0, 0, w, h);
    ctx.strokeStyle = '#d4cbb8';
    ctx.beginPath();
    ctx.moveTo(24, h - 20); ctx.lineTo(w - 10, h - 20);
    ctx.moveTo(24, 10); ctx.lineTo(24, h - 20);
    ctx.stroke();
    ctx.strokeStyle = '#0AA3C2';
    ctx.lineWidth = 2;
    ctx.beginPath();
    for (let i = 0; i <= 200; i++) {
      const x = i / 200;
      const y = Hb(Math.min(0.999, Math.max(0.001, x)));
      const px = 24 + x * (w - 34);
      const py = h - 20 - y * (h - 36);
      if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
    }
    ctx.stroke();
    const px = 24 + p * (w - 34);
    const py = h - 20 - Hb(p) * (h - 36);
    ctx.fillStyle = '#B87333';
    ctx.beginPath();
    ctx.arc(px, py, 5, 0, Math.PI * 2);
    ctx.fill();
  }

  function update() {
    const p = Number(slider.value);
    const h = Hb(p);
    out.textContent = `p = ${p.toFixed(3)}  →  H(p) = ${h.toFixed(4)} bit`;
    draw(p);
  }
  slider.addEventListener('input', update);
  update();
</script>
