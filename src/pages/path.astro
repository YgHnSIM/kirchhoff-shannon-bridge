---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllDocs, TRACK_META, hrefOf, slugOf, type Track } from '../lib/curriculum';

const all = await getAllDocs();
const phaseColor: Record<Track, string> = {
  foundation: 'var(--ink)',
  kirchhoff: 'var(--copper)',
  shannon: 'var(--cyan)',
  bridge: 'linear-gradient(var(--copper), var(--cyan))',
};
const phaseIntro: Record<Track, string> = {
  foundation: '측정·추상화·수학·역사·물리 복습. 오래 쉰 학습자의 재진입로.',
  kirchhoff: '회로 이전사 → KCL/KVL → 회로망 → 분광·복사 → 플랑크 직전 → 생애.',
  shannon: '불 대수 계전기 → 정보 → 엔트로피 → 원천·채널 → 비밀성 → 생애.',
  bridge: '보존 은유 → 두 엔트로피(S≠H) → 흑체에서 비트 → 생애 비교 → 더 읽기.',
};
---
<BaseLayout title="학습 경로" description="「두 엔트로피」 Phase A–D 전체 학습 경로">
  <div style="max-width:var(--max);margin:0 auto">
    <h1>학습 경로</h1>
    <p style="color:var(--ink-muted)">
      CURRICULUM.md에 고정된 순서입니다. 복귀 학습자는 foundation을 끝까지,
      이미 회로·정보에 익숙하면 Bridge의 \(S \neq H\)부터 건너뛸 수도 있습니다 —
      다만 기초 문서의 「한계」 절은 한 번 훑는 것을 권합니다.
    </p>

    {
      all.map(({ track, entries }) => (
        <section class="path-phase" style={`--phase-color: ${track === 'bridge' ? 'var(--copper)' : phaseColor[track]}`}>
          <p class="badge" style="margin:0 0 0.5rem">
            Phase {track === 'foundation' ? 'A' : track === 'kirchhoff' ? 'B' : track === 'shannon' ? 'C' : 'D'} · {TRACK_META[track].labelKo}
          </p>
          <h2>{TRACK_META[track].label}</h2>
          <p style="color:var(--ink-muted);margin-top:0.35rem">{phaseIntro[track]}</p>
          <ol class="path-list">
            {entries.map((e) => (
              <li>
                <div>
                  <a href={hrefOf(track, slugOf(e))}>{e.data.title}</a>
                  <span class="sum">{e.data.summary}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>
